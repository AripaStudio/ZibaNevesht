<UserControl x:Class="ZibaNevesht.UserControls.UCgoshBeZang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ZibaNevesht.ViewModels"
             xmlns:services="clr-namespace:ZibaNevesht.Services"
             mc:Ignorable="d" 
             d:DesignHeight="490" d:DesignWidth="800">


    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0"
                Margin="15"
                Padding="12"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="{DynamicResource CardCornerRadius}"
                BorderBrush="{DynamicResource BorderBrushTheme}"
                BorderThickness="1">

            <TextBlock FontSize="24" 
                       HorizontalAlignment="Center"
                       FontFamily="{DynamicResource PersianFont}">
                <Run Text="{Binding Path=[GoshBeZangHeaderPrefix], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
                <Run Text="{Binding Path=[GoshBeZangHeaderTitle], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                <Run Text="{Binding Path=[GoshBeZangHeaderSuffix], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
            </TextBlock>
        </Border>

        <!-- Main Content Split -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Section 1: Add to List -->
            <Border Grid.Column="0" 
                    Style="{StaticResource ThemeCardStyle}" 
                    Margin="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Path=[GoshBeZangAddRequirement], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" 
                               Style="{StaticResource ThemeTitleTextStyle}" 
                               HorizontalAlignment="Right"
                               Margin="0,0,0,10"
                               FontFamily="{DynamicResource PersianFont}"/>
                    <TextBox x:Name="InputTextBox" 
                             Text="{Binding VmGoshBeZangPage.NewItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ThemeTextBoxStyle}"
                             FontFamily="{DynamicResource PersianFont}"/>
                    
                    <!-- Added ComboBox -->
                    <TextBlock Text="{Binding Path=[GoshBeZangSelectCategories], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" 
                               Style="{StaticResource ThemeTitleTextStyle}" 
                               FontSize="14"
                               HorizontalAlignment="Right"
                               Margin="0,10,0,5"
                               FontFamily="{DynamicResource PersianFont}"/>
                    <ComboBox ItemsSource="{Binding VmGoshBeZangPage.RadehaList}" 
                              SelectedItem="{Binding VmGoshBeZangPage.SelectedRade}"
                              Style="{StaticResource ThemeComboBoxStyle}"
                              Margin="0,0,0,10"
                              FontFamily="{DynamicResource PersianFont}"/>

                    <Button Content="{Binding Path=[GoshBeZangAddButton], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" 
                            Command="{Binding VmGoshBeZangPage.AddItemCommand}"
                            Style="{StaticResource ThemeButtonStyle}" 
                            HorizontalAlignment="Right" 
                            Margin="0,10,0,0"
                            FontFamily="{DynamicResource PersianFont}"/>
                </StackPanel>
            </Border>

            <!-- Section 2: List and Delete -->
            <Border Grid.Column="1" 
                    Style="{StaticResource ThemeCardStyle}" 
                    Margin="10">
                <StackPanel>
                    <TextBlock Text="{Binding Path=[GoshBeZangListTitle], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" 
                               Style="{StaticResource ThemeTitleTextStyle}" 
                               Margin="0,0,0,10"
                               FontFamily="{DynamicResource PersianFont}"/>
                    <ListBox x:Name="ItemsListBox" 
                             ItemsSource="{Binding VmGoshBeZangPage.ItemsList}"
                               SelectedItem="{Binding VmGoshBeZangPage.SelectedItem, Mode=TwoWay}"
                             Background="Transparent" 
                             BorderBrush="{DynamicResource BorderBrushTheme}"
                             Height="200"
                             Margin="0,0,0,10"
                             FontFamily="{DynamicResource PersianFont}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3"
                                        Padding="10"
                                        CornerRadius="8"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushTheme}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{DynamicResource PersianFont}">
                                            <Run Text="{Binding Path=[GoshBeZangItemNameFormat], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"/>
                                            <Run Text="{Binding  NameWord}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontFamily="{DynamicResource PersianFont}">
                                            <Run Text="{Binding Path=[GoshBeZangHardnessLevelFormat], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"/>
                                            <Run Text="{Binding AlertLevel}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="{Binding Path=[GoshBeZangDeleteSelected], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" 
                                Command="{Binding VmGoshBeZangPage.DeleteItemCommand}"
                                Style="{StaticResource ThemeButtonStyle}" 
                                Margin="0,0,5,0"
                                FontFamily="{DynamicResource PersianFont}"/>
                        <Button Content="{Binding Path=[GoshBeZangDeleteAll], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}" 
                                Command="{Binding VmGoshBeZangPage.DeleteAllItemsCommand}"
                                Style="{StaticResource ThemeButtonStyle}" 
                                Margin="5,0,0,0"
                                FontFamily="{DynamicResource PersianFont}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
