<UserControl x:Class="ZibaNevesht.UserControls.UCmainZibaNevesht"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZibaNevesht.UserControls"
             xmlns:vm="clr-namespace:ZibaNevesht.ViewModels"
             xmlns:services="clr-namespace:ZibaNevesht.Services"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
   
    <UserControl.Resources>

        <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="Transparent">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource BorderBrushTheme}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}"/>

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>

                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeToggleStyle" TargetType="ToggleButton">

            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrushTheme}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse x:Name="Dot"
                                         Width="10"
                                         Height="10"
                                         Fill="{DynamicResource BorderBrushTheme}"
                                         Margin="0,0,8,0"/>

                                <ContentPresenter/>

                            </StackPanel>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                                <Setter TargetName="Dot"
                                        Property="Fill"
                                        Value="LimeGreen"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushTheme}"
            BorderThickness="0,0,0,1"
            Padding="20,18,20,15">

            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                              ShadowDepth="2"
                              Direction="270"
                              Color="#20000000"
                              Opacity="0.08"/>
            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Text="{Binding Path=[MainWelcomeMessage], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                       FontFamily="{DynamicResource PersianFont}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

                <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="{DynamicResource PageBackgroundBrush}"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    Padding="5"
                    BorderBrush="{DynamicResource BorderBrushTheme}"
                    BorderThickness="1">

                    <StackPanel Orientation="Horizontal">

                        <RadioButton Content="{Binding Path=[MainTabZibaNevesht], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                                 Style="{StaticResource NavTabButtonStyle}"
                                 FontFamily="{DynamicResource PersianFont}"
                                 IsChecked="{Binding IsZibaNeveshtSelected,Mode=TwoWay, FallbackValue=True}"/>

                        <RadioButton Content="{Binding Path=[MainTabGoshBeZang], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                                 Style="{StaticResource NavTabButtonStyle}"
                                 FontFamily="{DynamicResource PersianFont}"
                                 IsChecked="{Binding IsGoshBeZangSelected,Mode=TwoWay}"/>

                        <RadioButton Content="{Binding Path=[MainTabMishmare], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                                 Style="{StaticResource NavTabButtonStyle}"
                                 FontFamily="{DynamicResource PersianFont}"
                                 IsChecked="{Binding IsMishmarehSelected,Mode=TwoWay}"/>

                        <RadioButton Content="{Binding Path=[MainTabAbout], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                                 Style="{StaticResource NavTabButtonStyle}"
                                 FontFamily="{DynamicResource PersianFont}"
                                 IsChecked="{Binding IsAboutSelected,Mode=TwoWay}"/>

                    </StackPanel>

                </Border>

                <ToggleButton Grid.Row="1"
                          Grid.Column="1"
                          HorizontalAlignment="Right"
                          Margin="20,0,0,0"
                          Content="{Binding Path=[MainThemeToggleLabel], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                          FontFamily="{DynamicResource PersianFont}"
                          Style="{StaticResource ThemeToggleStyle}"
                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"/>


                <ComboBox Grid.Row="1" 
                      Grid.Column="2" 
                      HorizontalAlignment="Right"
                      Margin="15,0,0,0"
                      MinWidth="140"
                      Style="{StaticResource ThemeComboBoxStyle}"
                      SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"
                      ItemsSource="{Binding ComboBoxItemsSourceLis}" />

            </Grid>

        </Border>

        <ContentControl Grid.Row="1"
                    Margin="15"
                    Content="{Binding CurrentView}"/>

    </Grid>


</UserControl>
