<UserControl x:Class="ZibaNevesht.UserControls.UCzibaNeveshtChakameNevisan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ZibaNevesht.ViewModels"
             xmlns:local="clr-namespace:ZibaNevesht.UserControls"
             xmlns:services="clr-namespace:ZibaNevesht.Services"
             mc:Ignorable="d" 
             
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:VMzibaNeveshChakameNevisanPage></vm:VMzibaNeveshChakameNevisanPage>
    </UserControl.DataContext>


    <UserControl.Resources>

        <Style x:Key="PoetTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="Transparent">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}"/>

                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>

                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="{DynamicResource CardBackgroundBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="MainToggleStyle" TargetType="ToggleButton">

            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Padding"
                    Value="25,12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource BorderBrushTheme}"
                                BorderThickness="1.5">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <Ellipse x:Name="statusDot"
                                         Width="12"
                                         Height="12"
                                         Fill="{DynamicResource MutedTextBrush}"
                                         Margin="0,0,10,0"/>

                                <ContentPresenter/>

                            </StackPanel>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="btnBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryBrush}"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                                <Setter TargetName="statusDot"
                                        Property="Fill"
                                        Value="#00FF66"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="btnBorder"
                                        Property="Opacity"
                                        Value="0.9"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="10"
            Padding="6"
            Margin="15"
            BorderBrush="{DynamicResource BorderBrushTheme}"
            BorderThickness="1">

            <UniformGrid HorizontalAlignment="Center"
                     Columns="6">

                <RadioButton Content="{Binding Path=[PoetKhayyam], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                         GroupName="PoetsGroup"
                         Style="{StaticResource PoetTabStyle}"
                         FontFamily="{DynamicResource PersianFont}"
                         IsChecked="{Binding IsKhayyamSelected,Mode=TwoWay}"/>

                <RadioButton Content="{Binding Path=[PoetRodaki], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                         GroupName="PoetsGroup"
                         Style="{StaticResource PoetTabStyle}"
                         FontFamily="{DynamicResource PersianFont}"
                         IsChecked="{Binding IsRoudakiSelected,Mode=TwoWay}"/>

                <RadioButton Content="{Binding Path=[PoetBabaTaher], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                         GroupName="PoetsGroup"
                         Style="{StaticResource PoetTabStyle}"
                         FontFamily="{DynamicResource PersianFont}"
                         IsChecked="{Binding IsBabaTaherSelected,Mode=TwoWay}"/>

                <RadioButton Content="{Binding Path=[PoetSaadi], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                         GroupName="PoetsGroup"
                         Style="{StaticResource PoetTabStyle}"
                         FontFamily="{DynamicResource PersianFont}"
                         IsChecked="{Binding IsSaadiSelected,Mode=TwoWay}"/>

                <RadioButton Content="{Binding Path=[PoetHafez], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                         GroupName="PoetsGroup"
                         Style="{StaticResource PoetTabStyle}"
                         FontFamily="{DynamicResource PersianFont}"
                         IsChecked="{Binding IsHafizSelected,Mode=TwoWay}"/>

            </UniformGrid>

        </Border>

        <Grid Grid.Row="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">

            <TextBlock Text="{Binding Path=[ZibaNeveshtDescription], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                   Foreground="{DynamicResource TextBrush}"
                   FontFamily="{DynamicResource PersianFont}"
                   FontSize="15"
                   Opacity="0.6"/>

        </Grid>

        <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,0,0,35">

            <ToggleButton Content="{Binding Path=[ZibaNeveshtStartButton], Source={x:Static services:LocalizationProvider.Instance}, Mode=OneWay}"
                      Style="{StaticResource MainToggleStyle}"
                      FontFamily="{DynamicResource PersianFont}"
                      IsChecked="{Binding IsActive,Mode=TwoWay}"/>

        </StackPanel>

    </Grid>

</UserControl>
